{
  "name": "diabetic-utils",
  "version": "1.5.0",
  "description": "Compatibility shim for GlucoseIQ — re-exports @glucoseiq/core so existing `diabetic-utils` imports keep working. New projects should use @glucoseiq/core.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marklearst/glucoseiq.git",
    "directory": "packages/diabetic-utils"
  },
  "homepage": "https://glucoseiq.health",
  "bugs": {
    "url": "https://github.com/marklearst/glucoseiq/issues"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "diabetes",
    "glucose",
    "cgm",
    "glucoseiq",
    "a1c",
    "time-in-range"
  ],
  "author": "Mark Learst",
  "license": "MIT",
  "dependencies": {
    "@glucoseiq/core": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
