{
  "name": "@glucoseiq/cli",
  "version": "0.0.0",
  "description": "Zero-code CGM analysis: `npx @glucoseiq/cli report data.csv` prints a clinician-grade glucose report \u2014 metrics, episodes, and optional AGP SVG \u2014 powered by @glucoseiq/core.",
  "bin": {
    "glucoseiq": "./dist/bin.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marklearst/glucoseiq.git",
    "directory": "packages/cli"
  },
  "homepage": "https://glucoseiq.health",
  "bugs": {
    "url": "https://github.com/marklearst/glucoseiq/issues"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "glucoseiq",
    "cli",
    "cgm",
    "glucose",
    "agp",
    "csv"
  ],
  "author": "Mark Learst",
  "license": "MIT",
  "dependencies": {
    "@glucoseiq/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.1.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
