{
  "name": "@glucoseiq/testing",
  "version": "0.0.0",
  "description": "Deterministic, seedable mock-CGM data generator and scenario fixtures for testing GlucoseIQ-powered apps \u2014 realistic circadian curves, meal spikes, nocturnal hypos, and sensor gaps.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marklearst/glucoseiq.git",
    "directory": "packages/testing"
  },
  "homepage": "https://glucoseiq.health",
  "bugs": {
    "url": "https://github.com/marklearst/glucoseiq/issues"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "glucoseiq",
    "cgm",
    "mock",
    "fixtures",
    "testing",
    "glucose"
  ],
  "author": "Mark Learst",
  "license": "MIT",
  "dependencies": {
    "@glucoseiq/core": "workspace:^"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.1.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
